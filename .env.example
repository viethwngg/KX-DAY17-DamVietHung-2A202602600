# Offline is the default. Live benchmark requires an explicit --live flag.
LLM_LIVE=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
OPENAI_API_KEY=

# Provider-specific keys: CUSTOM_API_KEY, GEMINI_API_KEY (or GOOGLE_API_KEY),
# ANTHROPIC_API_KEY, OPENROUTER_API_KEY. Ollama does not require an API key.
# CUSTOM_BASE_URL=http://localhost:1234/v1
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_BASE_URL=...

COMPACT_THRESHOLD_TOKENS=1400
COMPACT_KEEP_MESSAGES=6
# LAB_STATE_DIR=state

# Optional independent judge configuration; offline quality uses a heuristic.
# JUDGE_PROVIDER=ollama
# JUDGE_MODEL=llama3.2
